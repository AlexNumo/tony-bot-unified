# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN="YOUR_BOT_TOKEN_FROM_BOTFATHER"

# Render Webhook Configuration (leave empty for local dev polling)
WEBHOOK_URL=""
# e.g. https://tony-bot-unified.onrender.com

# Server Port & Env
PORT=3000
NODE_ENV="production"
USE_POLLING=false

# Supabase Configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SECRET_KEY="your-service-role-key"
SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# AI Integrations
GROQ_API_KEY="gsk_your_groq_api_key"
GEMINI_API_KEY="your_gemini_api_key"

# WayForPay Integration
WAYFORPAY_MERCHANT_ACCOUNT="your_merchant_account"
WAYFORPAY_MERCHANT_SECRET_KEY="your_merchant_secret"

# Google Sheets Webhook (Optional CRM sync)
GOOGLE_SHEET_WEBHOOK_URL=""

# Local storage fallback mode
USE_LOCAL_DB=false

# Admin Dashboard Protection
ADMIN_EMAIL="admin@tonypashko.com"
ADMIN_PASSWORD="your_secure_password_here"
